#!/usr/bin/env python3
"""Operator CLI for sc- releases. Implementation lives in deploy/release.py."""
import importlib.util
import sys
from pathlib import Path

_PATH = Path(__file__).resolve().parent / "release.py"
_SPEC = importlib.util.spec_from_file_location("sc_release", _PATH)
_MODULE = importlib.util.module_from_spec(_SPEC)
sys.modules[_SPEC.name] = _MODULE
_SPEC.loader.exec_module(_MODULE)

if __name__ == "__main__":
    sys.exit(_MODULE.main())
